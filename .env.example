# Copy to .env.local for local development.
# For Vercel: set these in Project → Settings → Environment Variables
# (Production = main, Preview = dev and other branches).

# ---------- Local ----------
# Leave empty when using Vite proxy (api served from same host in dev).
# VITE_API_BASE=

# dev | production. Use "dev" for local and Vercel Preview.
# VITE_ENVIRONMENT=dev

# Optional override; default is sydplove-bingo-card-{VITE_ENVIRONMENT}.
# VITE_S3_BUCKET_NAME=

# VITE_AWS_REGION=us-east-1

# Site password (PasswordAuth). Use a strong value in production.
# VITE_SITE_PASSWORD=

# ---------- Dev (Vercel Preview) ----------
# Set in Vercel → Environment Variables → Preview.
# VITE_API_BASE= (usually empty; same origin)
# VITE_ENVIRONMENT=dev
# VITE_S3_BUCKET_NAME=sydplove-bingo-card-dev
# VITE_AWS_REGION=us-east-1
# VITE_SITE_PASSWORD= (your dev password)

# ---------- Production (Vercel Production) ----------
# Set in Vercel → Environment Variables → Production.
# VITE_API_BASE= (usually empty)
# VITE_ENVIRONMENT=production
# VITE_S3_BUCKET_NAME=sydplove-bingo-card-production
# VITE_AWS_REGION=us-east-1
# VITE_SITE_PASSWORD= (strong production password)
