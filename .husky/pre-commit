#!/bin/bash
# Pre-commit hook to scan for secrets and credentials
# This prevents accidentally committing sensitive information

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔍 Scanning for secrets and credentials..."

# Patterns to detect
PATTERNS=(
    "AKIA[0-9A-Z]{16}"                    # AWS Access Key ID
    "aws_access_key_id\s*=\s*['\"]?AKIA" # AWS Access Key in config
    "aws_secret_access_key\s*=\s*['\"]?[A-Za-z0-9/+=]{40}" # AWS Secret Key
    "-----BEGIN\s+(RSA\s+)?PRIVATE\s+KEY-----" # Private keys
    "-----BEGIN\s+EC\s+PRIVATE\s+KEY-----"     # EC Private keys
    "-----BEGIN\s+DSA\s+PRIVATE\s+KEY-----"   # DSA Private keys
    "-----BEGIN\s+OPENSSH\s+PRIVATE\s+KEY-----" # OpenSSH keys
    "sk_live_[0-9a-zA-Z]{24,}"           # Stripe live secret key
    "sk_test_[0-9a-zA-Z]{24,}"           # Stripe test secret key
    "rk_live_[0-9a-zA-Z]{24,}"           # Stripe restricted key
    "xox[baprs]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}" # Slack tokens
    "xoxp-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}" # Slack legacy tokens
    "ghp_[0-9a-zA-Z]{36}"                # GitHub personal access token
    "gho_[0-9a-zA-Z]{36}"                # GitHub OAuth token
    "ghu_[0-9a-zA-Z]{36}"                # GitHub user-to-server token
    "ghs_[0-9a-zA-Z]{36}"                # GitHub server-to-server token
    "ghr_[0-9a-zA-Z]{36}"                # GitHub refresh token
    "AIza[0-9A-Za-z\\-_]{35}"            # Google API key
    "ya29\\.[0-9A-Za-z\\-_]+"            # Google OAuth token
    "AIzaSy[0-9A-Za-z\\-_]{33}"          # Google API key (new format)
    "password\s*=\s*['\"][^'\"]{8,}"     # Password assignments
    "secret\s*=\s*['\"][^'\"]{8,}"       # Secret assignments
    "api[_-]?key\s*=\s*['\"][^'\"]{8,}"  # API key assignments
    "token\s*=\s*['\"][^'\"]{8,}"        # Token assignments
)

# Files to check (staged files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No staged files to check"
    exit 0
fi

FOUND_SECRETS=0
SECRET_DETAILS=""

for file in $STAGED_FILES; do
    # Skip binary files
    if git diff --cached -- "$file" | grep -q "^Binary files"; then
        continue
    fi
    
    # Get file content
    FILE_CONTENT=$(git show ":$file" 2>/dev/null || cat "$file" 2>/dev/null)
    
    if [ -z "$FILE_CONTENT" ]; then
        continue
    fi
    
    # Check each pattern
    for pattern in "${PATTERNS[@]}"; do
        if echo "$FILE_CONTENT" | grep -qiE "$pattern"; then
            FOUND_SECRETS=$((FOUND_SECRETS + 1))
            MATCHES=$(echo "$FILE_CONTENT" | grep -iE "$pattern" | head -3)
            SECRET_DETAILS="${SECRET_DETAILS}\n${RED}⚠️  Found potential secret in: $file${NC}"
            SECRET_DETAILS="${SECRET_DETAILS}\n   Pattern: $pattern"
            SECRET_DETAILS="${SECRET_DETAILS}\n   Matches:\n${MATCHES}\n"
        fi
    done
done

if [ $FOUND_SECRETS -gt 0 ]; then
    echo -e "${RED}❌ SECURITY ALERT: Potential secrets detected!${NC}"
    echo -e "$SECRET_DETAILS"
    echo ""
    echo -e "${YELLOW}Please remove secrets before committing.${NC}"
    echo -e "${YELLOW}If this is a false positive, you can bypass with:${NC}"
    echo -e "${YELLOW}  git commit --no-verify${NC}"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ No secrets detected${NC}"
exit 0

